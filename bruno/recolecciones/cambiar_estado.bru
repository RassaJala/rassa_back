meta {
  name: Cambiar estado recolección
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/recolecciones/{{recoleccionId}}/estado/
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Accept: application/json
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "estado": "en_ruta"
  }
}
