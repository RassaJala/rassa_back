  url: {{baseUrl}}/api/chat/conversaciones/19/override-nombre/
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{accessToken}}
  Content-Type: application/json
}

body:json {
  {
    "nombre_override": true
  }
}
