meta {
  name: Restaurar producto semanal
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/api/publicaciones/{{publicacionId}}/productos/{{productoId}}/restore/
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{accessToken}}
}

vars:pre-request {
  baseUrl: http://localhost:8000
  publicacionId: 4
  productoId: 6
}
