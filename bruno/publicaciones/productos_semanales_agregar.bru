meta {
  name: Agregar producto semanal
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/publicaciones/{{publicacionId}}/productos/
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "fk_producto": 1,
    "fk_unidad": 1,
    "stock": 10,
    "precio": "25.00",
    "foto": "http://ejemplo.com/foto.jpg"
  }
}
