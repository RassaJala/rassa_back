meta {
  name: Procesar Pago
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/pagos/
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "pedido": 1,
    "tipo_pago": 1,
    "monto": 116.00
  }
}
