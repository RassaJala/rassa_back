meta {
  name: Change Password
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/auth/change-password/
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "old_password": "secreta123",
    "new_password": "nuevaClave456"
  }
}
