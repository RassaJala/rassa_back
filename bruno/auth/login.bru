meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/token/
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "admin@rassa.com",
    "password": "{{userPassword}}"
  }
}

vars:pre-request {
  userPassword: admin123
  baseUrl: http://127.0.0.1:8000/
}
