meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/token/
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{testEmail}}",
    "password": "{{testPassword}}"
  }
}

vars:pre-request {
  baseUrl: http://localhost:8000
  testEmail: maria.lopez@email.com
  testPassword: maria123
}
