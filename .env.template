# ============================================================
# Rassa Backend — Variables de Entorno
# ============================================================
# Copia este archivo como .env y ajusta los valores.
#   cp .env.template .env
#
# Todas las variables tienen defaults seguros para desarrollo.
# En produccion, cambia SECRET_KEY y DEBUG obligatoriamente.
# ============================================================

# Clave secreta de Django (cambiar en produccion)
SECRET_KEY=changeme

# Modo debug (False en produccion)
DEBUG=True

# URL de conexion a la base de datos
# Formato: postgres://usuario:password@host:puerto/nombre
DATABASE_URL=postgres://postgres:postgres@localhost:5432/rassa

# Hosts permitidos (separados por coma)
ALLOWED_HOSTS=localhost,127.0.0.1

# Origenes CORS permitidos (separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006
